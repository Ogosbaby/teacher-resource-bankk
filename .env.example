# ---------------------------------------------------------------------------
# Copy to .env and fill in. `cp .env.example .env`
# NEVER commit real credentials here — .env is gitignored, this template is not.
# ---------------------------------------------------------------------------

# Neon (cloud) Postgres with the pgvector extension. Grab this from the Neon
# dashboard: Project -> Connection Details -> "Pooled connection" string.
# There is no local/Docker Postgres in this project.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# Auth.js v5. Generate with: openssl rand -base64 32
AUTH_SECRET=

# Optional — Google provider only loads when BOTH of these are set.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Seeded by `npm run seed`
ADMIN_EMAIL=admin@trb.local
ADMIN_PASSWORD=ChangeMe123!

# Locally hosted models via Ollama's OpenAI-compatible endpoint.
#
# Ollama must already be running before AI features work, and it needs the
# embeddings flag enabled:
#   ollama serve --embeddings
#
# Pull the embedding model once (separate from the chat model — a generative
# model will not produce usable embeddings):
#   ollama pull mxbai-embed-large
#
# QWEN_EMBEDDING_MODEL must return 1024 dimensions to match the VECTOR(1024)
# columns in src/lib/db/migrations/0001_init.sql.
#
# QWEN_MODEL must exist in Ollama as a tag. Build it from your own GGUF with:
#   ollama create qwen-local -f Modelfile
# The registration flow probes for it via GET /api/model/local, which reads
# Ollama's native /api/tags (using the host root derived from QWEN_BASE_URL above).
QWEN_BASE_URL=http://localhost:11434/v1
QWEN_API_KEY=not-needed
QWEN_MODEL=qwen-local
QWEN_EMBEDDING_MODEL=mxbai-embed-large

# In production (e.g. Vercel), point QWEN_BASE_URL/QWEN_API_KEY/QWEN_MODEL at
# a hosted OpenAI-compatible Qwen endpoint instead (DeepInfra, OpenRouter,
# Together AI, Fireworks, etc.) — Ollama itself cannot run on Vercel. See the
# README for details.

# WhatsApp number for the landing page's "Continue on WhatsApp" support
# hand-off, in international format with no + or spaces (e.g. 2348012345678).
NEXT_PUBLIC_WHATSAPP_SUPPORT_NUMBER=

# Transactional email, for renewal reminders.
#
# Get a key from https://resend.com/api-keys. Leave it empty and reminders are
# still queued and logged, they just are not delivered — nothing else breaks.
#
# REMINDER_FROM_EMAIL must be an address on a domain you have verified with
# Resend. Left unset it falls back to Resend's shared sender, which only delivers
# to the address that owns the account (fine for testing the integration).
RESEND_API_KEY=
REMINDER_FROM_EMAIL=

# Optional signing key for per-code revocations.
#
# With it set, /api/subscriptions/sync signs the revocation list it reports, so a
# TLS-intercepting proxy cannot cancel a teacher's code on their device. The PEM
# must be the SAME P-256 keypair that signs the code batch
# (.activation-keys/private.pem) — the app verifies the document against the
# batch's shipped public key, so any other key produces signatures it refuses.
#
# Accepts a raw PEM, a base64-encoded PEM, or a PEM with \n escapes. Left empty,
# the route reports the list unsigned, which is all local development needs.
# ACTIVATION_SIGNING_KEY=

# ---------------------------------------------------------------------------
# Storage for generated certificate PDFs.
#
# Leave all four R2_* values empty and the app falls back to writing under
# .storage/ in the project directory — fine for development, NOT durable, and
# not for production. Set all four to activate Cloudflare R2.
# The bucket does not need to be public: downloads stream through an
# ownership-checked API route.
# ---------------------------------------------------------------------------
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

# Override where the local storage fallback writes (default: ./.storage)
# STORAGE_LOCAL_DIR=
