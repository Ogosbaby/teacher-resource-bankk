<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Restrict all network traffic to secure TLS/HTTPS -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <!-- Specific domain pinning/enforcement for Teacher Resource Bank -->
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="true">teacher-resource-bankk.vercel.app</domain>
        <domain includeSubdomains="true">api.paystack.co</domain>
        <domain includeSubdomains="true">huggingface.co</domain>
        <domain includeSubdomains="true">neon.tech</domain>
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </domain-config>
</network-security-config>
